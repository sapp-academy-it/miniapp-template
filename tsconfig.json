{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "/components/*": ["./src/components/*"],
      "/lib/*": ["./src/lib/*"],
      "@/*": ["./src/*"],
      "app/*": ["./app/*"]
    }
  },
  "include": ["src", "app"]
}
